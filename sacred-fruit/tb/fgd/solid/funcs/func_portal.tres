description = "Linked portal surface. Link two portals with matching target/targetname."
base_classes = Array[Resource]([ExtResource("2_func_base"), ExtResource("3_target_base"), ExtResource("4_targetname_base")])
class_properties = {
"enabled": true,
"exit_offset": 0.12,
"plugin_face_from_portal_texture": true,
"plugin_keep_viewports_hot": true,
"plugin_teleport_collision_mask": 1048575,
"plugin_use_opposite_face": false,
"portal_axis": "auto",
"portal_debug": false,
"render_camera_offset": 0.0,
"render_min_link_distance": 0.03,
"render_scale": 0.75,
"render_use_oblique_clip": false,
"render_use_window_projection": true,
"reverse_normal": false,
"target": "",
"targetname": "",
