}
class_property_descriptions = {
"enabled": "Enable/disable this portal at runtime.",
"exit_offset": "How far from the destination portal plane to place teleported entities.",
"plugin_face_from_portal_texture": "If true, detect the portal-textured brush face and place runtime portal on that exact side.",
"plugin_keep_viewports_hot": "If true, keep paired portal viewports updating while the player overlaps the teleport area; disable for better performance in dense portal maps.",
"plugin_teleport_collision_mask": "Physics mask used by plugin portal teleport area to detect teleportable bodies.",
"plugin_use_opposite_face": "If true, place plugin Portal3D on the opposite brush face (fixes face-side convention mismatch).",
"portal_axis": "Portal facing axis override: auto, x, -x, y, -y, z, -z.",
"portal_debug": "Print runtime portal diagnostics and show magenta fallback if render path is invalid.",
"render_camera_offset": "Small view-only offset along destination portal normal (0 for best seam alignment).",
"render_min_link_distance": "Keeps the portal render camera at least this far from the linked portal plane to reduce close-angle warping.",
"render_scale": "Portal render resolution scale. Lower = faster.",
"render_use_oblique_clip": "Enable oblique near-plane clipping aligned to destination portal plane when engine projection API supports it.",
"render_use_window_projection": "Use off-axis portal window projection for seam-accurate alignment.",
"reverse_normal": "Flip portal facing direction if teleporting from wrong side.",
"target": "Link to the destination portal targetname. TrenchBroom should show a link arrow when selected.",
"targetname": "Name used by other portals' target key for linking. TrenchBroom should show a link arrow when selected.",
"teleport_cooldown": "Seconds of re-teleport protection after crossing.",
"use_portals_plugin": "If true, spawn and use addon Portal3D for rendering/teleport instead of custom FuncPortal camera path."
}
meta_properties = {
"color": Color(0.2, 0.6, 1, 1)
}
