"auto_close": "If true, door closes after wait.",
"consume_required_key": "If true, consumes required_key when the door is opened.",
"lock_open": "If true, once opened the door cannot be closed by use/toggle.",
"move_pos": "Relative destination position in Quake Units.",
"required_key": "Key id required to open this door (example: blue, red, gold). Empty means no key required.",
"move_rot": "Rotation destination in degrees.",
"speed": "Move speed. Translation uses Quake Units per second; rotation-only doors use degrees per second.",
