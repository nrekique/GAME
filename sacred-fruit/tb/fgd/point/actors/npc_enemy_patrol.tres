[resource]
script = ExtResource("1_point")
scene_file = ExtResource("4_scene")
apply_scale_on_map_build = false
classname = "npc_enemy_patrol"
description = "Enemy patrol NPC preset. Uses default NPC scene with patrol AI enabled and dialogue disabled."
