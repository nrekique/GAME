class_properties = {
"ai_alert_duration": 4.0,
"ai_enabled": true,
"ai_patrol_speed": 2.5,
"ai_reacts_to_alerts": true,
"ai_route_id": "enemy_patrol",
"dialogue_enabled": false,
"dialogue_focus_bone_name": "spine.003",
"dialogue_focus_bone_offset": -0.06,
"dialogue_focus_height": 1.15,
"dialogue_once_flag": "",
"dialogue_resource_path": "res://data/dialogue/npc_default.md",
"dialogue_speaker_name": "",
"npc_visual_scale": 0.82
}
class_property_descriptions = {
"ai_alert_duration": "Seconds to remain in alert state after AI alert.",
"ai_enabled": "Always enabled for this preset.",
"ai_patrol_speed": "Movement speed while patrolling.",
"ai_reacts_to_alerts": "If true, reacts to GAME.ai_alerted events.",
"ai_route_id": "Patrol route id (must match ai_patrol_point.route_id).",
"dialogue_enabled": "Disabled for enemy preset by default.",
"dialogue_focus_bone_name": "Skeleton bone name used for dialogue camera aim.",
"dialogue_focus_bone_offset": "Vertical offset applied to the dialogue focus bone point.",
"dialogue_focus_height": "World-space head focus height for dialogue camera.",
"dialogue_once_flag": "Optional save key if dialogue is re-enabled.",
"dialogue_resource_path": "Dialogue file path if dialogue is re-enabled.",
"dialogue_speaker_name": "Speaker name override if dialogue is re-enabled.",
